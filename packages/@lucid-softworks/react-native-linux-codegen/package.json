  "description": "Linux-platform TurboModule code generator — emits JSI-HostObject C++ headers from @react-native/codegen NativeModule schemas",
  "license": "MIT",
  "author": "Lucid Softworks <hello@lucidsoft.works> (https://lucidsoft.works)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucid-softworks/react-native-linux.git",
    "directory": "packages/@lucid-softworks/react-native-linux-codegen"
  },
  "bugs": {
    "url": "https://github.com/lucid-softworks/react-native-linux/issues"
  },
  "homepage": "https://github.com/lucid-softworks/react-native-linux#readme",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf lib",
